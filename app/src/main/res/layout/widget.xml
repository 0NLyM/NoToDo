<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:fontFamily="@font/titoli"
            android:gravity="center_vertical"
            android:letterSpacing="0.06"
            android:text="@string/widget_header"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/capture"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/widget_capture"
            android:src="@drawable/widget_add" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist"
        android:text="@string/widget_empty"
        android:textColor="@color/text2"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
